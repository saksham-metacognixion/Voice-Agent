{
  "name": "@portal/api",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS on Fastify. Two entrypoints: main.ts (HTTP API) and worker.ts (BullMQ).",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --config nest-cli.worker.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "spike:retell": "dotenv -e ../../.env -- tsx scripts/retell-spike.ts",
    "samples:templates": "dotenv -e ../../.env -- tsx scripts/template-samples.ts",
    "samples:voices": "dotenv -e ../../.env -- tsx scripts/voice-samples.ts",
    "load:setup": "dotenv -e ../../.env -- tsx scripts/inbound-load-fixture.ts setup",
    "load:teardown": "dotenv -e ../../.env -- tsx scripts/inbound-load-fixture.ts teardown",
    "load:inbound": "k6 run test/load/inbound.k6.js",
    "load:reset": "dotenv -e ../../.env -- tsx scripts/inbound-load-fixture.ts reset",
    "bench:generation": "dotenv -e ../../.env -- tsx scripts/generation-bench.ts",
    "verify:d5-retell": "dotenv -e ../../.env -- tsx scripts/d5-retell-verify.ts",
    "verify:auth0": "dotenv -e ../../.env -- tsx scripts/auth0-verify.ts",
    "verify:d6": "tsc -p tsconfig.scripts.json && dotenv -e ../../.env -- node dist-scripts/scripts/d6-staging-verify.js",
    "dev:link-user": "dotenv -e ../../.env -- tsx scripts/dev-link-user.ts",
    "dev:seed-workspace": "dotenv -e ../../.env -- tsx scripts/dev-seed-workspace.ts",
    "openapi:generate": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@aws-sdk/client-kms": "^3.1136.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.68.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@portal/db": "workspace:*",
    "@portal/schemas": "workspace:*",
    "@prisma/instrumentation": "6.19.3",
    "@sentry/nestjs": "11.1.0",
    "bullmq": "^6.3.6",
    "disposable-email-domains-js": "1.26.0",
    "fastify": "^5.4.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "mammoth": "^1.13.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "retell-sdk": "6.0.1",
    "rxjs": "^7.8.0",
    "stripe": "22.6.2",
    "unpdf": "^1.8.1",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@portal/config": "workspace:*",
    "@swc/core": "^1.11.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.24",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.30.0",
    "jszip": "^3.10.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
