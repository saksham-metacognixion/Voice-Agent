{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-scripts",
    "rootDir": "./",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src",
    "test",
    "scripts/d6-staging-verify.ts"
  ],
  "exclude": [
