# ---- shared ----
NODE_ENV=development
APP_ENV=dev                          # dev | staging | prod — Retell agents are prefixed with this

# ---- database (Neon) ----
# Three URLs, two roles (§17, ADR 0006). Run `pnpm db:roles` once after `pnpm infra:up`
# to create the local login roles below.
#   portal_app    RLS-enforced. Every query must run inside withWorkspace().
#   portal_admin  owner/BYPASSRLS. Webhooks, worker, /admin/* and migrations only.
DATABASE_URL=postgresql://portal_app:portal_app@localhost:5432/portal?schema=public
ADMIN_DATABASE_URL=postgresql://portal_admin:portal_admin@localhost:5432/portal?schema=public
DIRECT_DATABASE_URL=postgresql://portal:portal@localhost:5432/portal?schema=public  # owner, unpooled, migrations only

# ---- redis (Docker service on the backend EC2 instance; local: docker compose) ----
REDIS_URL=redis://localhost:6379

# ---- api ----
API_PORT=4000
# Public URL Retell and Auth0 call back to (Stripe uses `stripe listen`, no tunnel needed).
# Baked into every Retell agent (webhook_url) and number (inbound_webhook_url) at create time,
# so a tunnel that changes hostname strands every object made against the old one. Use a
# fixed hostname in dev:
#   ngrok http 4000 --url=<name>.ngrok-free.app      (one static domain on the free plan)
# A cloudflared *quick* tunnel (…trycloudflare.com) changes on every restart; named cloudflared
# tunnels need the zone on Cloudflare DNS, and metacognixion.com is not.
API_PUBLIC_URL=http://localhost:4000
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---- Auth0: customer tenant (verified by the API on customer routes) ----
AUTH0_CUSTOMER_DOMAIN=               # e.g. portal-dev.us.auth0.com  → issuer https://<domain>/
                                     # Boot asserts this differs from AUTH0_STAFF_DOMAIN.
AUTH0_CUSTOMER_AUDIENCE=             # API identifier registered in the tenant, e.g. https://api.example.com
AUTH0_CUSTOMER_ACTION_SECRET=        # shared secret the Post-User-Registration Action sends to POST /webhooks/auth
AUTH0_CUSTOMER_M2M_CLIENT_ID=        # machine-to-machine app for Management API (sessions list/revoke)
AUTH0_CUSTOMER_M2M_CLIENT_SECRET=

# ---- Auth0: staff tenant (verified by the API on /admin/* routes) ----
AUTH0_STAFF_DOMAIN=
AUTH0_STAFF_AUDIENCE=
AUTH0_STAFF_M2M_CLIENT_ID=
AUTH0_STAFF_M2M_CLIENT_SECRET=
STAFF_ALLOWED_EMAIL_DOMAIN=metacognixion.com   # enforced by the staff tenant Post-Login Action

# ---- frontend/web (@auth0/auth0-spa-js — public client, PKCE. ADR 0008) ----
AUTH0_DOMAIN=                        # same tenant as AUTH0_CUSTOMER_DOMAIN
AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET — not used: the portal is a SPA (public client, PKCE). ADR 0008
# AUTH0_SECRET — not used: no server-side session cookie. ADR 0008
AUTH0_AUDIENCE=                      # same as AUTH0_CUSTOMER_AUDIENCE
APP_BASE_URL=http://localhost:3000

# ---- frontend/admin (@auth0/auth0-spa-js — public client, PKCE. ADR 0008) ----
ADMIN_AUTH0_DOMAIN=                  # same tenant as AUTH0_STAFF_DOMAIN
ADMIN_AUTH0_CLIENT_ID=
# ADMIN_AUTH0_CLIENT_SECRET — not used, same reason. ADR 0008
# ADMIN_AUTH0_SECRET — not used, same reason. ADR 0008
ADMIN_AUTH0_AUDIENCE=
ADMIN_APP_BASE_URL=http://localhost:3001

# ---- Retell (ADR 0003) ----
# One key per environment, from the Retell dashboard of the workspace for that environment.
# It is ALSO the webhook signing secret: x-retell-signature is HMAC-SHA256(raw body + ts, key),
# and only the key with the "webhook" badge in the dashboard verifies. There is no separate
# webhook secret. All Retell objects created outside prod are named `<APP_ENV>-…`.
RETELL_API_KEY=
RETELL_TIMEOUT_MS=20000              # per-attempt budget for Retell API calls (never on the inbound hot path)
RETELL_MAX_RETRIES=3                 # SDK backoff on 408/409/429/5xx and connection errors
# RETELL_INBOUND_MODE / RETELL_INBOUND_RESPONSE_JSON / RETELL_INBOUND_TIMEOUT_MS were the
# D2 inbound stub's switches. D4 replaced the stub with the real §13.9 path, which decides
# from Redis; the spike behaviour they existed to establish is written down in ADR 0003 §1.
# See INBOUND_REDIS_DOWN_POLICY below for the one knob that remains.

# ---- Stripe (§13.7) ----
# Test keys outside prod, live keys only in prod: the API refuses a live key when APP_ENV != prod.
# Checkout Sessions return to PORTAL_URL/onboarding/activate?session_id=… and
# PORTAL_URL/app/wallet?checkout=cancelled, so PORTAL_URL must be right for the environment.
STRIPE_SECRET_KEY=                   # sk_test_… (restricted keys rk_test_… also work)
# Webhook signing secret for the endpoint that points at /webhooks/stripe. In dev this is the
# whsec_… printed by `stripe listen --forward-to localhost:4000/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=              # frontend only

# ---- Anthropic (brief → prompt generation only, never in the call path; ADR 0009) ----
# Needed from D2: the generation benchmark runs that day alongside the in-call model benchmark.
# `pnpm doctor` reports it as missing until set.
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5     # claude-opus-5 if the D2 benchmark shows Sonnet's prompts produce worse test calls

# ---- email ----
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# ---- analytics / observability ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- webhook fixture capture (dev/staging only; hard-off when APP_ENV=prod) ----
# Every webhook that reaches the API is written to FIXTURE_DIR/<provider>/<event>-<ts>.json
# with headers and the exact raw body, so D3's signature and metering tests use real payloads.
FIXTURE_DIR=test/fixtures            # relative to the api package cwd
CAPTURE_FIXTURES=true                # set false to silence capture without changing APP_ENV

# ---- encryption ----
SIP_CREDENTIALS_KMS_KEY_ID=          # AWS KMS key that wraps the SIP credential data key (AES-256-GCM)
AWS_REGION=ca-central-1   # ACM for CloudFront must still be requested in us-east-1 (ADR 0008)

# ---- call runtime (D4, §13.9, §13.10, §14) ----
# What the inbound authorisation answers when Redis does not respond inside its 150 ms
# budget (ADR 0003 §12). `open` (default) answers 200 {} and lets the number's bound agent
# take the call; `closed` answers reject:true — a busy tone for every caller — and exists
# for an operator who prefers that during an incident.
INBOUND_REDIS_DOWN_POLICY=open
# Signs the one-hour recording links of GET /calls/:id/recording (§17). At least 32
# characters. Unset means a per-process secret: fine on one dev box, wrong anywhere the API
# runs as more than one process, because a link minted by one is refused by the other.
RECORDING_SIGNING_SECRET=
# Namespace for every BullMQ key. Defaults to `portal:<APP_ENV>`; set it only to isolate a
# test run sharing one Redis with a running API.
BULLMQ_PREFIX=
# Write a fixture for every §13.9 inbound webhook. Off by default even in dev: it is the one
# route with a latency SLO, and a load run with this on writes a file per request.
CAPTURE_INBOUND_FIXTURES=false
