# ---- shared ----
NODE_ENV=development
APP_ENV=dev                          # dev | staging | prod — Retell agents are prefixed with this

# ---- database (RDS on staging/prod, local Docker in dev — ADR 0016) ----
# Three URLs, two roles (§17, ADR 0006). Run `pnpm db:roles` once after `pnpm infra:up`
# to create the local login roles below.
#   portal_app    RLS-enforced. Every query must run inside withWorkspace().
#   portal_admin  owner/BYPASSRLS. Webhooks, worker, /admin/* and migrations only.
DATABASE_URL=postgresql://portal_app:portal_app@localhost:5432/portal?schema=public
ADMIN_DATABASE_URL=postgresql://portal_admin:portal_admin@localhost:5432/portal?schema=public
DIRECT_DATABASE_URL=postgresql://portal:portal@localhost:5432/portal?schema=public  # owner, unpooled, migrations only

# ---- redis (Docker service on the backend EC2 instance; local: docker compose) ----
REDIS_URL=redis://localhost:6379

# ---- api ----
API_PORT=4000
# Public URL Retell and Auth0 call back to (Stripe uses `stripe listen`, no tunnel needed).
# Baked into every Retell agent (webhook_url) and number (inbound_webhook_url) at create time,
# so a tunnel that changes hostname strands every object made against the old one. Use a
# fixed hostname in dev:
#   ngrok http 4000 --url=<name>.ngrok-free.app      (one static domain on the free plan)
# A cloudflared *quick* tunnel (…trycloudflare.com) changes on every restart; named cloudflared
# tunnels need the zone on Cloudflare DNS, and metacognixion.com is not.
API_PUBLIC_URL=http://localhost:4000
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# A second origin the Auth0 tenant should also accept, when one tenant serves more than one
# (a developer on localhost while staging is deployed against the same tenant). Both end up
# in the SPA's callback, logout and web-origin lists; unset, nothing extra is sent.
# Without this, `pnpm auth0:deploy` for staging removes localhost and every local sign-in
# fails with "Callback URL mismatch".
PORTAL_ALT_URL=
ADMIN_ALT_URL=

# ---- Auth0: customer tenant (verified by the API on customer routes) ----
AUTH0_CUSTOMER_DOMAIN=               # e.g. portal-dev.us.auth0.com  → issuer https://<domain>/
                                     # Boot asserts this differs from AUTH0_STAFF_DOMAIN.
AUTH0_CUSTOMER_AUDIENCE=             # API identifier registered in the tenant, e.g. https://api.example.com
AUTH0_CUSTOMER_ACTION_SECRET=        # shared secret the Post-User-Registration Action sends to POST /webhooks/auth
AUTH0_CUSTOMER_M2M_CLIENT_ID=        # machine-to-machine app for Management API: session list/revoke,
AUTH0_CUSTOMER_M2M_CLIENT_SECRET=    # `pnpm auth0:deploy`, `verify:auth0`. Scopes: docs/runbooks/auth0.md §1.

# Optional, dev tenants only: an application with the Password grant enabled, so
# `verify:auth0` can sign in as a throwaway user and prove the JIT-provisioning path
# end to end before the portal has a login screen. Off by default — auth0.md §4.
AUTH0_CUSTOMER_TEST_CLIENT_ID=
AUTH0_CUSTOMER_TEST_CLIENT_SECRET=
AUTH0_CUSTOMER_TEST_CONNECTION=      # defaults to Username-Password-Authentication

# ---- Auth0: staff tenant (verified by the API on /admin/* routes) ----
AUTH0_STAFF_DOMAIN=
AUTH0_STAFF_AUDIENCE=
AUTH0_STAFF_M2M_CLIENT_ID=           # same, for the staff tenant; MFA scopes too (auth0.md §1)
AUTH0_STAFF_M2M_CLIENT_SECRET=
STAFF_ALLOWED_EMAIL_DOMAIN=metacognixion.com   # enforced by the staff tenant Post-Login Action

# ---- frontend/web (@auth0/auth0-spa-js — public client, PKCE. ADR 0008) ----
AUTH0_DOMAIN=                        # same tenant as AUTH0_CUSTOMER_DOMAIN
AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET — not used: the portal is a SPA (public client, PKCE). ADR 0008
# AUTH0_SECRET — not used: no server-side session cookie. ADR 0008
AUTH0_AUDIENCE=                      # same as AUTH0_CUSTOMER_AUDIENCE
APP_BASE_URL=http://localhost:3000
# The browser build reads NEXT_PUBLIC_* only (baked in at build time, ADR 0008). Locally
# frontend/web/next.config.ts derives them from the values above and API_PORT, so these
# stay unset on a dev box. CI and infra/scripts/deploy-frontend.sh set them per environment:
#   NEXT_PUBLIC_API_URL            https://api-staging.oraly.ai  (dev: http://localhost:4000)
#   NEXT_PUBLIC_AUTH0_DOMAIN       = AUTH0_DOMAIN
#   NEXT_PUBLIC_AUTH0_CLIENT_ID    = AUTH0_CLIENT_ID
#   NEXT_PUBLIC_AUTH0_AUDIENCE     = AUTH0_AUDIENCE
#   NEXT_PUBLIC_APP_ENV            = APP_ENV
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=

# ---- frontend/admin (@auth0/auth0-spa-js — public client, PKCE. ADR 0008) ----
ADMIN_AUTH0_DOMAIN=                  # same tenant as AUTH0_STAFF_DOMAIN
ADMIN_AUTH0_CLIENT_ID=
# ADMIN_AUTH0_CLIENT_SECRET — not used, same reason. ADR 0008
# ADMIN_AUTH0_SECRET — not used, same reason. ADR 0008
ADMIN_AUTH0_AUDIENCE=
ADMIN_APP_BASE_URL=http://localhost:3001

# ---- Retell (ADR 0003) ----
# One key per environment, from the Retell dashboard of the workspace for that environment.
# It is ALSO the webhook signing secret: x-retell-signature is HMAC-SHA256(raw body + ts, key),
# and only the key with the "webhook" badge in the dashboard verifies. There is no separate
# webhook secret. All Retell objects created outside prod are named `<APP_ENV>-…`.
RETELL_API_KEY=
RETELL_TIMEOUT_MS=20000              # per-attempt budget for Retell API calls (never on the inbound hot path)
RETELL_MAX_RETRIES=3                 # SDK backoff on 408/409/429/5xx and connection errors
# RETELL_INBOUND_MODE / RETELL_INBOUND_RESPONSE_JSON / RETELL_INBOUND_TIMEOUT_MS were the
# D2 inbound stub's switches. D4 replaced the stub with the real §13.9 path, which decides
# from Redis; the spike behaviour they existed to establish is written down in ADR 0003 §1.
# See INBOUND_REDIS_DOWN_POLICY below for the one knob that remains.
# May W3 play the voice platform's own catalogue clips? Several of them say the vendor's
# name out loud, and the clip URLs are its S3 bucket, so `deny` withholds both and the
# picker shows "Sample unavailable" until `voices.sample_url` holds a clip of ours.
# There is no text-to-speech route to make one with (ADR 0003 §9) — the agent speaks the
# customer's greeting for the first time on the W5 test call.
# Unset means `allow` only when APP_ENV=dev and `deny` everywhere else (staging included:
# a design partner heard a clip introduce itself "from Retail AI" on 25 Sep 2026).
VOICE_VENDOR_SAMPLES=allow           # allow | deny

# ---- Stripe (§13.7) ----
# Test keys outside prod, live keys only in prod: the API refuses a live key when APP_ENV != prod.
# Checkout Sessions return to PORTAL_URL/onboarding/activate?session_id=… and
# PORTAL_URL/app/wallet?checkout=cancelled, so PORTAL_URL must be right for the environment.
STRIPE_SECRET_KEY=                   # sk_test_… (restricted keys rk_test_… also work)
# Webhook signing secret for the endpoint that points at /webhooks/stripe. In dev this is the
# whsec_… printed by `stripe listen --forward-to localhost:4000/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=              # frontend only

# ---- Anthropic (brief → prompt generation only, never in the call path; ADR 0009) ----
# Needed from D2: the generation benchmark runs that day alongside the in-call model benchmark.
# `pnpm doctor` reports it as missing until set.
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5     # claude-opus-5 if the D2 benchmark shows Sonnet's prompts produce worse test calls
# Which provider the `prompting` module runs (ADR 0009). `anthropic` is the default;
# `scripted` answers from canned text so the wizard works on a machine with no key, and is
# refused outright when APP_ENV=prod.
GENERATION_PROVIDER=anthropic
GENERATION_TIMEOUT_MS=45000          # the whole call, in-provider retry included. §9.3 step 7 says 20 s,
                                     # written against a ≤10 s p95; measured p50 is ~15 s (ADR 0012).
GENERATION_MAX_TOKENS=16000          # a ceiling, not a cost: the call streams, so it is only spent if used
GENERATION_EFFORT=low                # low|medium|high|xhigh|max. `low` is the default: this is
                                     # structured drafting, and depth does not buy a better prompt.
GENERATION_THINKING=adaptive         # adaptive|off. Measured difference is under a second, so this
                                     # is a dial for the D2 benchmark rather than a latency fix.

# Where `templates/*.json` (§9.2) is, when it is not next to the app. Unset is normal:
# the API walks up from its working directory, and `pnpm db:seed` loads the same files.
TEMPLATES_DIR=

# ---- email ----
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
# Without RESEND_API_KEY, SMTP delivers instead (587 = STARTTLS, 465 = TLS). With Gmail use an
# app password, and EMAIL_FROM must be that account, e.g. "Oraly <you@gmail.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- analytics / observability ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# D7 Help (ADR 0019 §8), both optional. The support address defaults to support@oraly.ai;
# the status page is linked only when set to an https: URL (no vendor chosen yet, §20 item 10).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_STATUS_PAGE_URL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- webhook fixture capture (dev/staging only; hard-off when APP_ENV=prod) ----
# Every webhook that reaches the API is written to FIXTURE_DIR/<provider>/<event>-<ts>.json
# with headers and the exact raw body, so D3's signature and metering tests use real payloads.
FIXTURE_DIR=test/fixtures            # relative to the api package cwd
CAPTURE_FIXTURES=true                # set false to silence capture without changing APP_ENV

# ---- encryption (D6, §11.3 Option C, §17) ----
# SIP trunk passwords are envelope-encrypted: a fresh AES-256-GCM data key per secret,
# wrapped by a master. Staging and prod wrap with AWS KMS; dev and tests wrap with a local
# 32-byte key so a database dump still holds no plaintext. Exactly one of the two:
SIP_CREDENTIALS_KMS_KEY_ID=          # KMS key id or ARN (staging/prod). Needs kms:GenerateDataKey + kms:Decrypt.
SIP_CREDENTIALS_LOCAL_KEY=           # 64 hex chars (dev/ci only; refused when APP_ENV=prod). `openssl rand -hex 32`
AWS_REGION=ca-central-1   # ACM for CloudFront must still be requested in us-east-1 (ADR 0008)

# ---- operations alerts (D6) ----
# Where `OpsAlertService` posts when an activation or an auto top-up fails for good
# (`{text}` JSON — a Slack incoming webhook). Unset: the alert is a log line only.
OPS_ALERT_WEBHOOK_URL=

# ---- call runtime (D4, §13.9, §13.10, §14) ----
# What the inbound authorisation answers when Redis does not respond inside its 150 ms
# budget (ADR 0003 §12). `open` (default) answers 200 {} and lets the number's bound agent
# take the call; `closed` answers reject:true — a busy tone for every caller — and exists
# for an operator who prefers that during an incident.
INBOUND_REDIS_DOWN_POLICY=open
# Signs the one-hour recording links of GET /calls/:id/recording (§17). At least 32
# characters. Unset means a per-process secret: fine on one dev box, wrong anywhere the API
# runs as more than one process, because a link minted by one is refused by the other.
RECORDING_SIGNING_SECRET=
# D12 admin §7.4: signs the read-only view-as credential the console hands the portal. Falls back to
# RECORDING_SIGNING_SECRET; ≥ 32 chars; must be shared by every API process.
IMPERSONATION_SIGNING_SECRET=

# Namespace for every BullMQ key. Defaults to `portal:<APP_ENV>`; set it only to isolate a
# test run sharing one Redis with a running API.
BULLMQ_PREFIX=
# Write a fixture for every §13.9 inbound webhook. Off by default even in dev: it is the one
# route with a latency SLO, and a load run with this on writes a file per request.
CAPTURE_INBOUND_FIXTURES=false

# ---- recurring operations (D7, §13.11) ----
# Every value here has a working default; set one only to change the business rule.
# `reconcile-calls`: alert when |provider − ours| drifts past this percent of yesterday's calls
# (ids, or seconds on matched calls). Plan: 5.
RECONCILE_DRIFT_THRESHOLD_PCT=5
# `concurrency-monitor`: alert a workspace at this share of its plan cap (80 = 8 of 10 live calls).
CONCURRENCY_ALERT_PCT=80
# Our voice-platform plan's concurrent-call ceiling, for the platform-wide alert. Unset = not monitored.
CONCURRENCY_PLATFORM_LIMIT=
# `daily-digest`: local hour (0–23) after which a workspace's previous-day digest goes out, in
# *its* timezone. The schedule is hourly; this is when each workspace's turn comes.
DIGEST_LOCAL_HOUR=8
# Where the worker touches its liveness file for the compose healthcheck (D7). Default /tmp/worker.heartbeat.
WORKER_HEARTBEAT_FILE=

# ---- staging / prod compose only (infra/docker-compose.prod.yml) ----
# The public hostname Caddy terminates TLS for and the Let's Encrypt contact. Both live in
# SSM under /voice-agent/<env>/ like everything else; deploy.sh writes them into the box's .env.
API_DOMAIN=
ACME_EMAIL=
