# ---- shared ----
NODE_ENV=development
APP_ENV=dev                          # dev | staging | prod — Retell agents are prefixed with this

# ---- database (Neon) ----
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal?schema=public
DIRECT_DATABASE_URL=postgresql://portal:portal@localhost:5432/portal?schema=public  # unpooled, migrations only

# ---- redis (Railway) ----
REDIS_URL=redis://localhost:6379

# ---- api ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---- Clerk: customer application ----
CLERK_CUSTOMER_ISSUER=
CLERK_CUSTOMER_JWKS_URL=
CLERK_CUSTOMER_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Clerk: staff application ----
CLERK_STAFF_ISSUER=
CLERK_STAFF_JWKS_URL=
ADMIN_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
ADMIN_CLERK_SECRET_KEY=

# ---- Retell ----
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5

# ---- email ----
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# ---- analytics / observability ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- encryption ----
SIP_CREDENTIALS_DEK=                 # base64 32-byte key for AES-256-GCM (P1); KMS-wrapped in P2
