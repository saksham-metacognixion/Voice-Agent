# dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# build output
dist/
build/
.next/
# `next dev` writes here, so a build never clobbers a running dev server
.next-dev/
out/
.turbo/
*.tsbuildinfo

# env and secrets
.env
.env.*
!.env.example
*.pem
*.key

# test and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# rendered spec pages (large, regenerate with docs/tools/pdfdump.swift)
docs/spec-extract/*.png
docs/spec-extract/render/
*.png.tmp

# local tooling
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
pnpm-debug.log*

# auth0 tenant exports — a snapshot of the live tenant for diffing, with tenant-specific
# ids and placeholder secrets in it. The source of truth is infra/auth0/tenant.*.yaml.
infra/auth0/export/

# prisma
packages/db/prisma/*.db
packages/db/prisma/*.db-journal
.retell-spike.json
.d6-verify.json
backend/api/dist-scripts/
backend/api/dist-worker/

# raw webhook captures (FixtureWriter names them <event>-<ISO timestamp>.json).
# Curated fixtures are named by behaviour and have no timestamp, so they stay tracked.
# Keep one file per behaviour, rename it, delete the rest — see backend/api/test/fixtures/README.md.
backend/api/test/fixtures/*/*-20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]T*.json

# wizard end-to-end run output (frontend/web/scripts/e2e-wizard.mjs)
frontend/web/.e2e/

# scratch output written into the repo by mistake (a relative /tmp path)
tmp/

# git worktrees Claude Code creates for isolated agents (`git worktree list` is the record)
.claude/worktrees/
