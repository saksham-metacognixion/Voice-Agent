    {
      "name": "B. Retell direct - what the gateway wraps",
      "item": [
        {
          "name": "1. list-voices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{retell_api_key}}"
              }
            ],
            "url": {
              "raw": "https://api.retellai.com/list-voices",
              "protocol": "https",
              "host": [
                "api",
                "retellai",
                "com"
              ],
              "path": [
                "list-voices"
              ]
            },
            "description": "The W3 catalogue: 301 voices. Each carries preview_audio_url - that clip IS the voice preview; Retell has no text-to-speech preview endpoint (ADR 0003 sec 9)."
          },
          "response": []
        },
        {
          "name": "2. get-concurrency",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{retell_api_key}}"
              }
            ],
            "url": {
              "raw": "https://api.retellai.com/get-concurrency",
              "protocol": "https",
              "host": [
                "api",
                "retellai",
                "com"
              ],
              "path": [
                "get-concurrency"
              ]
            },
            "description": "Workspace call pool: base 20, purchasable to 200. Inbound, outbound and browser calls all draw from it (ADR 0003 sec 10)."
          },
          "response": []
        },
        {
          "name": "3. create-retell-llm",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{retell_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://api.retellai.com/create-retell-llm",
              "protocol": "https",
              "host": [
                "api",
                "retellai",
                "com"
              ],
              "path": [
                "create-retell-llm"
              ]
            },
            "description": "Step 1 of an agent: the prompt and model live on the LLM object. Saves llm_id to the environment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gpt-5-mini\",\n  \"general_prompt\": \"You are the receptionist for Maple Dental, a family dental clinic in Toronto. Hours are Monday to Friday, 9am to 5pm. Keep every reply under 25 words.\",\n  \"begin_message\": \"Thanks for calling {{business_name}}, how can I help?\",\n  \"start_speaker\": \"agent\",\n  \"default_dynamic_variables\": {\n    \"business_name\": \"Maple Dental\",\n    \"agent_name\": \"Maya\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.llm_id) pm.environment.set('llm_id', j.llm_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. create-agent (draft v0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{retell_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://api.retellai.com/create-agent",
              "protocol": "https",
              "host": [
                "api",
                "retellai",
                "com"
              ],
              "path": [
                "create-agent"
              ]
            },
            "description": "Returns version 0, is_published false.\n\nTwo things to notice: language is an ARRAY of locales (ADR 0003 sec 6), and all four sec 9.8 analysis types are accepted (sec 11).\n\nwebhook_url must be your live ngrok URL or no events will ever arrive. Saves agent_id.",
            "body": {
              "mode": "raw",
