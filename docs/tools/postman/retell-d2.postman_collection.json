{
  "info": {
    "_postman_id": "3371bd51-2960-4ada-a816-3b6fdaf49d51",
    "name": "Voice Agent - Retell D2 verification",
    "description": "Folder A hits our API on :4000. Folder B hits Retell directly, so you can see what RetellGateway wraps.\n\nSetup: import the environment file next to this one, select it, and paste your Retell API key into retell_api_key (the only blank). Check public_url matches the running ngrok URL.\n\nEvery request's Docs tab says what it proves. The findings are written up in docs/decisions/0003-retell-findings.md, with the captured payloads in backend/api/test/fixtures/retell/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A. Our API (localhost:4000)",
      "item": [
        {
          "name": "1. Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/health",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness. Run this first - everything below assumes the API is up on :4000."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('up', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Mint web-call token (dev only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base}}/dev/retell/web-call",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "dev",
                "retell",
                "web-call"
              ]
            },
            "description": "Goes through RetellGateway.createWebCall. Proves our API can reach Retell and returns access_token, call_id, transport, ice_servers.\n\nPostman cannot carry audio. For the actual call open http://localhost:3000/dev/test-call, paste the agent id, press Start, allow the mic.\n\nRoute is 404 unless APP_ENV=dev.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agent_id\": \"{{agent_id}}\",\n  \"agent_version\": 0,\n  \"max_call_duration_ms\": 60000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token minted', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.access_token).to.be.a('string');",
                  "  pm.expect(j.transport).to.eql('gateway');",
                  "  pm.environment.set('call_id', j.call_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Inbound webhook - allow {}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base}}/webhooks/retell/inbound/{{number_token}}?mode=allow",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "webhooks",
                "retell",
                "inbound",
                "{{number_token}}"
              ],
              "query": [
                {
                  "key": "mode",
                  "value": "allow"
                }
              ]
            },
            "description": "Simulates Retell's call_inbound authorisation webhook. Expect 200 with {} (or whatever RETELL_INBOUND_RESPONSE_JSON holds).\n\nA fixture appears in backend/api/test/fixtures/retell/ with signature_valid true, because the pre-request script signs the body exactly as Retell does.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"call_inbound\",\n  \"event_timestamp\": 1789450192487,\n  \"call_inbound\": {\n    \"call_id\": \"call_postman_1\",\n    \"agent_id\": \"{{agent_id}}\",\n    \"agent_version\": 0,\n    \"from_number\": \"+15550000001\",\n    \"to_number\": \"{{phone_number}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Retell signs: v=<ms>,d=hex(HMAC-SHA256(rawBody + ms, API key)) - same thing our gateway verifies.",
                  "const ts = Date.now();",
                  "const raw = pm.request.body ? pm.request.body.raw : '';",
                  "const digest = CryptoJS.HmacSHA256(raw + ts, pm.environment.get('retell_api_key')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-retell-signature', value: 'v=' + ts + ',d=' + digest });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 allow', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Inbound webhook - allow with override",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base}}/webhooks/retell/inbound/{{number_token}}?mode=allow&response={{inbound_response_b64}}",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "webhooks",
                "retell",
                "inbound",
                "{{number_token}}"
              ],
              "query": [
                {
                  "key": "mode",
                  "value": "allow"
                },
                {
                  "key": "response",
                  "value": "{{inbound_response_b64}}"
                }
              ]
            },
            "description": "Same request, but the allow body is carried in the URL as base64url JSON. The pre-request script builds inbound_response_b64 from inbound_response_json for you.\n\nExpect the override echoed back: override_agent_id, dynamic_variables, metadata and agent_override.agent.max_call_duration_ms. This is the shape sec 13.9 will return in production.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"call_inbound\",\n  \"event_timestamp\": 1789450192487,\n  \"call_inbound\": {\n    \"call_id\": \"call_postman_2\",\n    \"agent_id\": \"{{agent_id}}\",\n    \"agent_version\": 0,\n    \"from_number\": \"+15550000001\",\n    \"to_number\": \"{{phone_number}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('inbound_response_b64',",
                  "  CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(pm.environment.get('inbound_response_json')))",
                  "    .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, ''));",
                  "// Retell signs: v=<ms>,d=hex(HMAC-SHA256(rawBody + ms, API key)) - same thing our gateway verifies.",
                  "const ts = Date.now();",
                  "const raw = pm.request.body ? pm.request.body.raw : '';",
                  "const digest = CryptoJS.HmacSHA256(raw + ts, pm.environment.get('retell_api_key')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-retell-signature', value: 'v=' + ts + ',d=' + digest });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('override echoed', () =>",
                  "  pm.expect(pm.response.json().call_inbound.agent_override.agent.max_call_duration_ms).to.eql(60000));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Inbound webhook - decline (reject:true)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base}}/webhooks/retell/inbound/{{number_token}}?mode=decline_reject",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "webhooks",
                "retell",
                "inbound",
                "{{number_token}}"
              ],
              "query": [
                {
                  "key": "mode",
                  "value": "decline_reject"
                }
              ]
            },
            "description": "The ONLY real decline (ADR 0003 sec 1). Expect 200 with {\"call_inbound\":{\"reject\":true}}.\n\nAgainst real Retell: caller hears busy, no call object is created, cost is zero.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"call_inbound\",\n  \"event_timestamp\": 1789450192487,\n  \"call_inbound\": {\n    \"call_id\": \"call_postman_3\",\n    \"agent_id\": \"{{agent_id}}\",\n    \"agent_version\": 0,\n    \"from_number\": \"+15550000001\",\n    \"to_number\": \"{{phone_number}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Retell signs: v=<ms>,d=hex(HMAC-SHA256(rawBody + ms, API key)) - same thing our gateway verifies.",
                  "const ts = Date.now();",
                  "const raw = pm.request.body ? pm.request.body.raw : '';",
                  "const digest = CryptoJS.HmacSHA256(raw + ts, pm.environment.get('retell_api_key')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-retell-signature', value: 'v=' + ts + ',d=' + digest });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reject', () => pm.expect(pm.response.json().call_inbound.reject).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Inbound webhook - 403 (NOT a decline)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base}}/webhooks/retell/inbound/{{number_token}}?mode=decline_403",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "webhooks",
                "retell",
                "inbound",
                "{{number_token}}"
              ],
              "query": [
                {
                  "key": "mode",
                  "value": "decline_403"
                }
              ]
            },
            "description": "Expect 403, empty body.\n\nAgainst real Retell this is not a decline at all: it retries 3x about 0.8 s apart and then answers with the number's bound agent. Change mode to decline_500 (same behaviour) or decline_timeout (holds 15 s; Retell gives up at 10 s and the caller rings out).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"call_inbound\",\n  \"event_timestamp\": 1789450192487,\n  \"call_inbound\": {\n    \"call_id\": \"call_postman_4\",\n    \"agent_id\": \"{{agent_id}}\",\n    \"agent_version\": 0,\n    \"from_number\": \"+15550000001\",\n    \"to_number\": \"{{phone_number}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Retell signs: v=<ms>,d=hex(HMAC-SHA256(rawBody + ms, API key)) - same thing our gateway verifies.",
                  "const ts = Date.now();",
                  "const raw = pm.request.body ? pm.request.body.raw : '';",
                  "const digest = CryptoJS.HmacSHA256(raw + ts, pm.environment.get('retell_api_key')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-retell-signature', value: 'v=' + ts + ',d=' + digest });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Agent webhook - replay a real call_ended (signed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_base}}/webhooks/retell",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "webhooks",
                "retell"
              ]
            },
            "description": "A real captured call_ended, trimmed to the fields metering reads, re-signed with a fresh valid signature.\n\nToday: 200 {received:true} and a new fixture with signature_valid true.\n\nSend it TWICE. Both are accepted today. From D3 the second must return 204 - this request is the exactly-once regression test.\n\nNote in the body: duration comes from end_timestamp - start_timestamp (ms), call_cost is in CENTS as floats, and metadata carries tenant_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"call_ended\",\n  \"call\": {\n    \"call_id\": \"call_1d3267c6d47427b466beb1d1d1e\",\n    \"call_type\": \"phone_call\",\n    \"agent_id\": \"agent_c72a20039d1559e8c6e345c03c\",\n    \"agent_version\": 1,\n    \"call_status\": \"ended\",\n    \"direction\": \"inbound\",\n    \"from_number\": \"+19377293562\",\n    \"to_number\": \"+16204459730\",\n    \"start_timestamp\": 1789450314512,\n    \"end_timestamp\": 1789450374516,\n    \"duration_ms\": 60004,\n    \"disconnection_reason\": \"max_duration_reached\",\n    \"metadata\": {\n      \"tenant_id\": \"ws_spike\",\n      \"number_id\": \"num_spike\",\n      \"tier\": \"standard\"\n    },\n    \"retell_llm_dynamic_variables\": {\n      \"diversion\": \"<sip:+16204459730@twilio.com>;reason=unconditional\",\n      \"p-asserted-identity\": \"<sip:+19377293562@sip.retellai.com>\",\n      \"twilio-accountsid\": \"AC[redacted]\",\n      \"twilio-callsid\": \"CA[redacted]\",\n      \"twilio-verstat\": \"TN-Validation-Passed-B\",\n      \"business_name\": \"Maple Dental Override\",\n      \"agent_name\": \"Maya\"\n    },\n    \"call_cost\": {\n      \"product_costs\": [\n        {\n          \"product\": \"retell_voice_engine\",\n          \"unit_price\": 0.0916667,\n          \"cost\": 5.5916687\n        },\n        {\n          \"product\": \"elevenlabs_tts_03_2026\",\n          \"unit_price\": 0.0666667,\n          \"cost\": 4.0666687\n        },\n        {\n          \"product\": \"gpt_5_mini\",\n          \"unit_price\": 0.0133333,\n          \"cost\": 0.8133313\n        },\n        {\n          \"product\": \"us_twilio_telephony\",\n          \"unit_price\": 0.025,\n          \"cost\": 1.525\n        },\n        {\n          \"product\": \"gpt_5_6_terra_text_testing\",\n          \"unit_price\": 2.08,\n          \"cost\": 2.08\n        }\n      ],\n      \"total_duration_seconds\": 61,\n      \"total_duration_unit_price\": 0.1966667,\n      \"combined_cost\": 14.0766687\n    },\n    \"transcript\": \"Agent: Thank \\nUser: Hi there. Is Do you open on Saturdays? \\nUser: Saturdays? \\nUser: Saturdays? \\nAgent: Hello! We\\u2019re a family dental clinic in Toronto. We\\u2019re open Monday\\u2013Friday 9am\\u20135pm, closed Saturdays. May I have your name?\\nUser: Thanks. Are there parking facilities or nearby parking options? \\nAgent: Hello! We have limited on-site parking and street parking nearby; for details please provide your name and I\\u2019ll note to call you back.\\nUser: Thanks. Do you accept new patients? \\nAgent: Hello! Yes, we accept new patients. May I have your name to book or schedule a callback?\\nUser: Thanks. What do you charge for a routine cleaning? \\nAgent: Hello! Routine cleaning fees vary; our office will call you back with exact pricing. May I have your name?\\nUser: Thanks. How do you handle dental emergencies? \\nAgent: Hello! For dental emergencies we provide same-day appointments when available; otherwise the office will call you back. May I have your name?\\nUser: Thanks. Do you accept insurance? \\n\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Retell signs: v=<ms>,d=hex(HMAC-SHA256(rawBody + ms, API key)) - same thing our gateway verifies.",
                  "const ts = Date.now();",
                  "const raw = pm.request.body ? pm.request.body.raw : '';",
                  "const digest = CryptoJS.HmacSHA256(raw + ts, pm.environment.get('retell_api_key')).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'x-retell-signature', value: 'v=' + ts + ',d=' + digest });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('received', () => pm.expect(pm.response.json().received).to.eql(true));",
                  "const c = JSON.parse(pm.request.body.raw).call;",
                  "pm.test('duration matches the sec 14.2 rule', () =>",
                  "  pm.expect((c.end_timestamp - c.start_timestamp) / 1000).to.eql(c.duration_ms / 1000));"
                ]
              }
            }
          ]
        },
        {
