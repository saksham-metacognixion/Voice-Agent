{
  "name": "voice-agent-portal",
  "private": true,
  "version": "0.0.1",
  "description": "Voice Agent Self-Service Portal \u2014 customer portal, admin console, API and worker",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev dev:worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "db:generate": "pnpm --filter @portal/db generate",
    "db:migrate": "pnpm --filter @portal/db migrate:dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "test:e2e": "turbo run test:e2e",
    "db:deploy": "pnpm --filter @portal/db migrate:deploy",
    "db:status": "pnpm --filter @portal/db migrate:status",
    "db:roles": "pnpm --filter @portal/db roles",
    "db:seed": "pnpm --filter @portal/db seed",
    "db:reset": "pnpm --filter @portal/db reset",
    "db:studio": "pnpm --filter @portal/db studio",
    "doctor": "node infra/scripts/doctor.mjs",
    "auth0:validate": "node infra/scripts/auth0.mjs validate",
    "auth0:check": "node infra/scripts/auth0.mjs check",
    "auth0:export": "node infra/scripts/auth0.mjs export",
    "auth0:plan": "node infra/scripts/auth0.mjs plan",
    "auth0:deploy": "node infra/scripts/auth0.mjs deploy",
    "verify:auth0": "pnpm --filter @portal/api verify:auth0",
    "dev:issuer": "node infra/scripts/local-issuer.mjs",
    "dev:issuer:staff": "LOCAL_ISSUER_MODE=staff node infra/scripts/local-issuer.mjs",
    "dev:stripe": "stripe listen --forward-to localhost:4000/webhooks/stripe"
  },
  "devDependencies": {
    "auth0-deploy-cli": "^9.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
