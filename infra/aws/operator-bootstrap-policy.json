{
  "Version": "2012-10-17",
  "Comment": [
    "Voice Agent \u2014 the IAM permissions the developer needs so CloudFormation can manage",
    "infra/aws/staging-stack.yaml. ADR 0015, ADR 0016.",
    "",
    "Attach to the IAM user that deploys the stack (voice-agent-devs). Every statement that can",
    "change or delete something is scoped by name to voice-agent-*, so it cannot read, change or",
    "delete another project's identities. There is no EC2, RDS, S3 or KMS action here at all, so",
    "it cannot touch an instance or a database belonging to anyone.",
    "",
    "Attaching a managed policy is restricted by iam:PolicyARN to our own voice-agent-* policies",
    "plus AmazonSSMManagedInstanceCore. Without that condition, 'attach a policy to a voice-agent-*",
    "identity' would mean 'attach AdministratorAccess to voice-agent-devs itself'.",
    "",
    "KNOWN, ACCEPTED: iam:CreateRole together with iam:PutRolePolicy still lets this user create a",
    "voice-agent-* role that trusts itself and give it an inline Action:* policy, i.e. become admin.",
    "Both are needed \u2014 CloudFormation writes the instance role's inline policy. Use",
    "operator-bootstrap-policy-strict.json with voice-agent-boundary-policy.json to close it: the",
    "strict variant only permits identities that carry the permissions boundary, and the boundary",
    "forbids iam:*. See docs/runbooks/staging.md step 0.",
    "",
    "Remove the Comment key before pasting: IAM rejects unknown top-level keys."
  ],
  "Statement": [
    {
      "Sid": "VoiceAgentRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::667723749107:role/voice-agent-*"
    },
    {
      "Sid": "VoiceAgentInstanceProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::667723749107:instance-profile/voice-agent-*"
    },
    {
      "Sid": "PassOnlyTheInstanceRoleAndOnlyToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::667723749107:role/voice-agent-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "VoiceAgentCiUser",
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:GetUser",
        "iam:TagUser",
        "iam:UntagUser",
        "iam:ListUserTags",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:ListAccessKeys",
        "iam:UpdateAccessKey"
      ],
      "Resource": "arn:aws:iam::667723749107:user/voice-agent-*"
    },
    {
      "Sid": "VoiceAgentManagedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:ListPolicyVersions",
        "iam:ListEntitiesForPolicy",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::667723749107:policy/voice-agent-*"
    },
    {
      "Sid": "AttachOnlyOurOwnPoliciesAndTheSsmManagedOne",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:AttachUserPolicy",
        "iam:DetachUserPolicy"
      ],
      "Resource": [
        "arn:aws:iam::667723749107:role/voice-agent-*",
        "arn:aws:iam::667723749107:user/voice-agent-*"
      ],
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": [
            "arn:aws:iam::667723749107:policy/voice-agent-*",
            "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlySoTheConsoleAndCloudFormationCanResolveNames",
      "Effect": "Allow",
      "Action": [
        "iam:ListRoles",
        "iam:ListUsers",
        "iam:ListPolicies",
        "iam:ListInstanceProfiles",
        "iam:GetAccountSummary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RdsCreatesItsServiceLinkedRoleOnFirstUse",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": ["rds.amazonaws.com", "ssm.amazonaws.com"]
        }
      }
    }
  ]
}
